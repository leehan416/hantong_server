GOOGLE_CLIENT_ID=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
PUBSUB_SUBSCRIPTION=
LOG_LEVEL=INFO
# Reverse-proxy addresses (IP or CIDR) whose X-Forwarded-For uvicorn trusts; read by uvicorn, not Settings.
FORWARDED_ALLOW_IPS=10.10.60.0/24
# Name of the Docker network created by Compose.
HANTONG_PROXY_NETWORK=hantong-proxy
